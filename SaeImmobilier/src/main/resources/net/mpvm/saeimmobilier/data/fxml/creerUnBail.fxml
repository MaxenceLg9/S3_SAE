<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Alert?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.mpvm.saeimmobilier.controleur.CtrlGererUnBail"
      spacing="10"
      alignment="CENTER"
      style="-fx-background-color: #2c3e50;"
      minWidth="1400"
      minHeight="650">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    
    <Label text="Création d'un nouveau bail" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    <Label fx:id="labelAdresse" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
    <Label fx:id="labelComplementAdresse" style="-fx-text-fill: white;"/>
    <Label fx:id="labelType" style="-fx-text-fill: white;"/>

    <GridPane fx:id="gridPaneContent" hgap="10" vgap="10" style="-fx-border-color: white; -fx-border-radius: 3; -fx-background-color: #34495e;">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="150"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
            <RowConstraints vgrow="NEVER"/>
        </rowConstraints>
        
        <!-- Colonne 1 - Libellés -->
        <Label text="Début" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
        <Label text="Fin" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
        <Label text="Signature" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
        <Label text="Loyer" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
        <Label text="Total Charges" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
        <Label text="Garantie" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-text-fill: white;"/>
        
        <!-- Colonne 2 - Champs de saisie -->
        <Label text="Dates du Bail" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        <DatePicker fx:id="dateDebut" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-color: #ecf0f1;"/>
        <DatePicker fx:id="dateFin" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-color: #ecf0f1;"/>
        <DatePicker fx:id="dateSignature" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-background-color: #ecf0f1;"/>
        <Label text="Charges" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        <TextField fx:id="fieldMontantLoyer" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-background-color: #ecf0f1;"/>
        <TextField fx:id="fieldTotalCharges" GridPane.rowIndex="6" GridPane.columnIndex="1" style="-fx-background-color: #ecf0f1;"/>
        <TextField fx:id="fieldDepotGarantie" GridPane.rowIndex="7" GridPane.columnIndex="1" style="-fx-background-color: #ecf0f1;"/>
        
        <!-- Colonne 3 - Type de Location -->
        <Label text="Type de Location" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        <CheckBox fx:id="checkBoxLocationSimple" text="Location Simple" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-text-fill: white;"/>
        <CheckBox fx:id="checkBoxColocation" text="Colocation" GridPane.rowIndex="2" GridPane.columnIndex="2" style="-fx-text-fill: white;"/>
        <TextField fx:id="fieldNbColocataires" promptText="Nombre de colocataires (1-8)" GridPane.rowIndex="3" GridPane.columnIndex="2" style="-fx-background-color: #ecf0f1;"/>
        <Label text="Options" GridPane.rowIndex="4" GridPane.columnIndex="2" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        <CheckBox fx:id="checkBoxArchive" text="Archive" GridPane.rowIndex="5" GridPane.columnIndex="2" style="-fx-text-fill: white;"/>
        <CheckBox fx:id="checkBoxRenouvelable" text="Renouvelable" GridPane.rowIndex="6" GridPane.columnIndex="2" style="-fx-text-fill: white;"/>
        
        <!-- Colonne 4 - Locataires -->
        <Label text="Locataires" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Nouveau Locataire" onAction="#newLocataire" GridPane.rowIndex="1" GridPane.columnIndex="3" styleClass="button-valider"/>

        
        <!-- Colonne 5 - Répartition Loyer -->
        <Label text="Répartition Loyer" GridPane.rowIndex="0" GridPane.columnIndex="4" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="4">
            <CheckBox fx:id="checkBoxLoyerEuro" text="Euro" style="-fx-text-fill: white;"/>
            <CheckBox fx:id="checkBoxLoyerPourcentage" text="Pourcentage" style="-fx-text-fill: white;"/>
        </HBox>
        <Label fx:id="labelResteLoyer" GridPane.rowIndex="10" GridPane.columnIndex="4" style="-fx-text-fill: white;"/>
        
        <!-- Colonne 6 - Répartition Charges -->
        <Label text="Répartition Charges" GridPane.rowIndex="0" GridPane.columnIndex="5" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="5">
            <CheckBox fx:id="checkBoxChargesEuro" text="Euro" style="-fx-text-fill: white;"/>
            <CheckBox fx:id="checkBoxChargesPourcentage" text="Pourcentage" style="-fx-text-fill: white;"/>
        </HBox>
        <Label fx:id="labelResteCharges" GridPane.rowIndex="10" GridPane.columnIndex="5" style="-fx-text-fill: white;"/>

        <Label text="Date Début" GridPane.rowIndex="0" GridPane.columnIndex="6" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        <Label text="Date Fin" GridPane.rowIndex="0" GridPane.columnIndex="7" style="-fx-text-fill: white; -fx-font-weight: bold;"/>

        <!-- Boutons de validation -->
        <HBox spacing="10" alignment="CENTER" GridPane.rowIndex="11" GridPane.columnIndex="0" GridPane.columnSpan="6">
            <Button text="Valider" onAction="#valider" minWidth="100" styleClass="button-valider"/>
            <Button text="Annuler" onAction="#annuler" minWidth="100" styleClass="button-supprimer"/>
            <Button text="Enregistrer PDF" onAction="#saveBailDoc" minWidth="100" styleClass="button-valider"/>
        </HBox>
    </GridPane>
</VBox> 