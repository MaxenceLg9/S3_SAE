<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.mpvm.saeimmobilier.controleur.CtrlViewImmeubles">
    <content>
        <VBox fx:id="vBoxImmeubles" alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" spacing="10.0" style="-fx-background-color: #2b3b50;" stylesheets="@../css/style.css" VBox.vgrow="ALWAYS">
            <children>
            <Label text="Liste des Immeubles" textFill="WHITE">
               <font>
                  <Font name="Cantarell Bold" size="30.0" />
               </font>
            </Label>
                <Button onAction="#retourAccueil" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: FF5900FF;" text="Retour à l'accueil" textFill="WHITE" />
            <Button onAction="#ajouterBien" prefHeight="45.0" prefWidth="200.0" styleClass="button-valider" text="Ajouter un Bien" textFill="WHITE" />
            <TableView fx:id="tableImmeubles" style="-fx-background-color: #2b3b50;" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
        </VBox>
    </content>
</ScrollPane>
