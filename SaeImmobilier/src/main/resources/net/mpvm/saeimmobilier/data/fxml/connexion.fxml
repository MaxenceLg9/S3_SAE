<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="backgroundColor" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.mpvm.saeimmobilier.controleur.CtrlConnexion">
   <center>
      <VBox alignment="CENTER" fillWidth="false" prefHeight="550.0" prefWidth="700.0" spacing="20.0">
      
          <Label fx:id="welcomeText" text="Se connecter" textFill="WHITE">
            <font>
               <Font name="System Bold" size="36.0" />
            </font>
         </Label>
         <TextField fx:id="FieldMail" alignment="CENTER" prefHeight="25.0" prefWidth="316.0" promptText="Entrez votre identifiant ou votre email" />
          <PasswordField fx:id="FieldPwd" alignment="CENTER" prefHeight="25.0" prefWidth="316.0" promptText="Entrez votre mot de passe" />
          <Button fx:id="btnConnexion" onAction="#Connexion" text="Connexion" />
         <Hyperlink fx:id="hyperLinkmdpOublie" onAction="#mdpOublie" text="Mot de passe oublié ?" />
      
      </VBox>
   </center>
   <bottom>
      <Button fx:id="BtwQuitter" minHeight="35.0" minWidth="125.0" mnemonicParsing="false" onAction="#Quitter" style="-fx-background-color: #E74C3C; -fx-background-radius: 10px;" text="Quitter" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" />
         </BorderPane.margin>
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </bottom>
</BorderPane>
