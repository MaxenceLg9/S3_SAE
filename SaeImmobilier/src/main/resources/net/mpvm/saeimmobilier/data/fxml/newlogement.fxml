<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="600.0" minWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.mpvm.saeimmobilier.controleur.CtrlNewBien">
    <children>
        <Label fx:id="labelTitle" text="Ajouter un nouveau bien" style="-fx-font-size: 18;" />
        <GridPane hgap="10" vgap="10" padding="20">
            <columnConstraints>
                <ColumnConstraints prefWidth="150.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="30.0" />
                <RowConstraints minHeight="60.0" />
                <RowConstraints minHeight="30.0" />
            </rowConstraints>
            <children>
                <Label text="Propriétaire" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="comboProprietaire" promptText="Sélectionner un propriétaire" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Adresse" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="fieldAdresse" promptText="Adresse complète" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="Code postal" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="fieldCodePostal" promptText="Ex: 75001" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label text="Ville" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="fieldVille" promptText="Nom de la ville" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                
                <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextArea fx:id="areaDescription" promptText="Description détaillée du bien" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                
                <Label text="Prix (€)" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextField fx:id="fieldPrix" promptText="Prix en euros" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>
        <GridPane hgap="10" padding="20">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Button text="Ajouter le bien" onAction="#ajouterBien" GridPane.columnIndex="0" />
                <Button text="Annuler" onAction="#annuler" GridPane.columnIndex="1" />
            </children>
        </GridPane>
    </children>
</VBox>
