<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<GridPane fx:id="root" prefHeight="720.0" prefWidth="1280.0" styleClass="backgroundColor" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.mpvm.saeimmobilier.controleur.CtrlLouerUnBien">
    <!-- Column Constraints -->
    <columnConstraints>
        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" /> <!-- New column for Bien info -->
        <ColumnConstraints />
        <ColumnConstraints />
    </columnConstraints>

    <!-- Row Constraints -->
    <rowConstraints>
        <!-- Header Row -->
        <RowConstraints minHeight="50.0" prefHeight="60.0" vgrow="NEVER" />
        <!-- Form Section -->
        <RowConstraints minHeight="200.0" valignment="CENTER" vgrow="ALWAYS" />
        <!-- Button Section -->
        <RowConstraints valignment="CENTER" vgrow="NEVER" />
    </rowConstraints>

    <!-- Header -->
    <Label text="Création du Bail" textFill="WHITE" GridPane.rowIndex="0">
        <font>
            <Font name="Calibri Bold" size="36.0" />
        </font>
        <GridPane.margin>
            <Insets bottom="20.0" top="20.0" />
        </GridPane.margin>
    </Label>

    <!-- Form Section -->
    <GridPane alignment="CENTER" hgap="20.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" style="-fx-background-color: #00002255; -fx-background-radius: 15px; -fx-background-insets: 0; -fx-border-color: #FFFFFF; -fx-border-radius: 15px;" vgap="10.0" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS">
        <rowConstraints>
            <RowConstraints maxHeight="-Infinity" minHeight="10.0" valignment="BOTTOM" vgrow="NEVER" />
            <RowConstraints maxHeight="-Infinity" minHeight="10.0" valignment="TOP" vgrow="NEVER" />
            <RowConstraints maxHeight="-Infinity" valignment="BOTTOM" vgrow="NEVER" />
            <RowConstraints maxHeight="-Infinity" minHeight="10.0" valignment="TOP" vgrow="NEVER" />
            <RowConstraints valignment="BOTTOM" vgrow="NEVER" />
            <RowConstraints valignment="TOP" vgrow="NEVER" />
         <RowConstraints minHeight="10.0" valignment="BOTTOM" vgrow="NEVER" />
            <RowConstraints valignment="TOP" vgrow="NEVER" />
            <RowConstraints valignment="CENTER" vgrow="NEVER" />
            <RowConstraints valignment="CENTER" vgrow="NEVER" />

        </rowConstraints>
        <Label fx:id="labelBienVille" text="" GridPane.columnIndex="2">
            <font>
                <Font name="Arial" size="16.0" />
            </font>
        </Label>
        <Label fx:id="labelBienType" text="" GridPane.columnIndex="2" GridPane.rowIndex="2">
            <font>
                <Font name="Arial" size="16.0" />
            </font>
        </Label>
        <Label fx:id="labelBienSurface" text="" GridPane.columnIndex="2" GridPane.rowIndex="3">
            <font>
                <Font name="Arial" size="16.0" />
            </font>
        </Label>

        <!-- Date Range (Start Date and End Date on Same Row) -->
        <Label text="Date de début" textFill="WHITE" GridPane.columnIndex="1" GridPane.halignment="LEFT">
            <font>
                <Font name="Arial Black" size="18.0" />
            </font>
        </Label>
        <DatePicker fx:id="dateDebut" maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="235.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Date de fin" textFill="WHITE" GridPane.columnIndex="2" GridPane.halignment="RIGHT">
            <font>
                <Font name="Arial Black" size="18.0" />
            </font>
        </Label>
        <DatePicker fx:id="dateFin" maxWidth="1.7976931348623157E308" prefHeight="35.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />

        <!-- Rent Amount -->
        <Label text="Montant du loyer" textFill="WHITE" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="2">
            <font>
                <Font name="Arial Black" size="18.0" />
            </font>
         <GridPane.margin>
            <Insets top="10.0" />
         </GridPane.margin>
        </Label>
        <TextField fx:id="fieldMontantLoyer" prefHeight="35.0" prefWidth="500.0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="3" />

        <!-- Total Charges -->
        <Label text="Total charges" textFill="WHITE" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="4">
            <font>
                <Font name="Arial Black" size="18.0" />
            </font>
         <GridPane.margin>
            <Insets top="10.0" />
         </GridPane.margin>
        </Label>
        <TextField fx:id="fieldTotalCharges" prefHeight="35.0" prefWidth="500.0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="5" />

        <!-- Security Deposit -->
        <Label text="Dépôt de garantie" textFill="WHITE" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="6">
            <font>
                <Font name="Arial Black" size="18.0" />
            </font>
         <GridPane.margin>
            <Insets top="10.0" />
         </GridPane.margin>
        </Label>
        <TextField fx:id="fieldDepotGarantie" prefHeight="35.0" prefWidth="500.0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="7" />

        <!-- Archive and Renewability Checkboxes on Same Row -->
        <Label text="Archive" textFill="WHITE" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.rowIndex="8">
            <font>
                <Font name="Arial Black" size="18.0" />
            </font>
        </Label>
        <CheckBox fx:id="checkBoxArchive" GridPane.columnIndex="2" GridPane.halignment="LEFT" GridPane.rowIndex="8" />

        <Label text="Renouvelable" textFill="WHITE" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.rowIndex="9">
            <font>
                <Font name="Arial Black" size="18.0" />
            </font>
        </Label>
        <CheckBox fx:id="checkBoxRenouvelable" GridPane.columnIndex="2" GridPane.halignment="LEFT" GridPane.rowIndex="9" />
      <Label fx:id="labelNumeroFiscal" text="Numero fiscal" textFill="WHITE" GridPane.rowIndex="1" />
      <Label fx:id="labelNomBienL" text="Nom" textFill="WHITE" />
      <Label fx:id="labelAdresse" text="Adresse" textFill="WHITE" GridPane.rowIndex="3" GridPane.valignment="CENTER" />
      <Label fx:id="labelType" text="Type" textFill="WHITE" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
      <Label fx:id="labelSurface" text="Surface" textFill="WHITE" GridPane.rowIndex="6" GridPane.valignment="CENTER" />
      <Label fx:id="labelNbPieces" text="NombrePieces" textFill="WHITE" GridPane.rowIndex="7" GridPane.valignment="CENTER" />
      <Label fx:id="labelDateAjout" text="DateAjout" textFill="WHITE" GridPane.rowIndex="8" />
      <columnConstraints>
         <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
         <ColumnConstraints halignment="CENTER" />
         <ColumnConstraints halignment="CENTER" />
      </columnConstraints>
      <padding>
         <Insets bottom="40.0" left="200.0" right="200.0" top="40.0" />
      </padding>
    </GridPane>

    <!-- Button Section -->
    <GridPane hgap="20.0" vgap="20.0" GridPane.rowIndex="2">
        <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" />
        </columnConstraints>

        <children>
            <!-- Valider Button -->
            <Button alignment="CENTER" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #4444FF; -fx-text-fill: white;" text="Valider" GridPane.columnIndex="3">
                <GridPane.margin>
                    <Insets />
                </GridPane.margin></Button>

            <!-- Annuler Button -->
            <Button prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #FF3333; -fx-text-fill: white;" text="Annuler" />

            <!-- Consult Bail Button -->
            <Button mnemonicParsing="false" style="-fx-background-color: #FF8822; -fx-text-fill: white;" text="Consulter le bail actuel/Commencer un bail" GridPane.columnIndex="2" />

            <!-- View All Leases Button -->
            <Button mnemonicParsing="false" style="-fx-background-color: #22FF55; -fx-text-fill: white;" text="Voir tous les baux" GridPane.columnIndex="1" />
        </children>

        <rowConstraints>
            <RowConstraints valignment="CENTER" vgrow="NEVER" />
        </rowConstraints>
        <GridPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </GridPane.margin>
    </GridPane>
</GridPane>
